{
  "entities": {
    "User": {
      "title": "User",
      "description": "Clinic user profile (Patient, Doctor, or Admin)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "specialty": { "type": "string" },
        "bio": { "type": "string" },
        "phone": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinic appointment booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Completed", "Cancelled", "No-Show"] },
        "patientName": { "type": "string" },
        "patientEmail": { "type": "string" },
        "doctorName": { "type": "string" },
        "specialty": { "type": "string" },
        "visitNote": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "patientId", "doctorId", "date", "startTime", "endTime", "status"]
    },
    "Availability": {
      "title": "Availability",
      "description": "Weekly recurring doctor availability slot block",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "doctorId": { "type": "string" },
        "dayOfWeek": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" }
      },
      "required": ["id", "doctorId", "dayOfWeek", "startTime", "endTime"]
    },
    "LeaveDay": {
      "title": "LeaveDay",
      "description": "Doctor leave record for a specific date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "doctorId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "doctorId", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for clinic staff and patients"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Booked consultations between patients and doctors"
    },
    "/availability/{availabilityId}": {
      "schema": "Availability",
      "description": "Doctor working schedules"
    },
    "/leaveDays/{leaveId}": {
      "schema": "LeaveDay",
      "description": "Doctor marked leaves"
    }
  }
}
